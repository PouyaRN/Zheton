{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pouyarn.github.io/Zheton/schema/rates.schema.json",
  "title": "Zheton Signed Market Rates Payload",
  "type": "object",
  "required": ["schema", "kid", "updatedAt", "generatedAt", "toman", "coins", "sources", "stale"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "kid": { "type": "string", "pattern": "^k[0-9]+$" },
    "updatedAt": { "type": "integer", "minimum": 1700000000000 },
    "generatedAt": { "type": "integer", "minimum": 1700000000000 },
    "toman": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "usd": {
      "type": "object",
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "change24h": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "sparklines": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "coins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "en": { "type": "string", "maxLength": 100 },
          "icon": { "type": "string" },
          "wallets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["network", "networkFa"],
              "properties": {
                "network": { "type": "string" },
                "networkFa": { "type": "string" },
                "contract": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "stale": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "latest": {
      "type": ["object", "null"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "apk": { "type": "string" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}

