<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Read-only, and asked for only when she switches bank messages on in settings. There is
        deliberately no RECEIVE_SMS and no receiver: the inbox is read when the app opens, which
        is the only time a balance is on screen anyway.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!--
        Reminders are local notifications (WorkManager, no server). Asked for only when she
        switches reminders on in settings — never at launch, where it would read as noise.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        READ_SMS is taken to mean "this app needs a radio", which would hide it from every
        tablet and Chromebook that has none. It does not: it reads the message store, and on a
        device with nothing in it the feature simply has nothing to show.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MuchToman"
        android:usesCleartextTraffic="false">
        <!--
            Handle configuration changes rather than being destroyed by them. Everything she
            commits is already in the Store, but what is half-typed is not: rotating the phone
            with a wallet address pasted into the sheet threw the sheet and the address away.
            And it was not only rotation — the theme is SYSTEM by default, so the phone going
            dark at sunset, or a change of display font size, recreated the activity in exactly
            the same way. Recreation also runs onStop, which re-arms the lock, so anyone with
            the app lock on was asked for a fingerprint every time they turned the phone.

            Compose republishes LocalConfiguration on onConfigurationChanged, so the theme and
            the font scale still follow the system without the activity dying for it.

            ponytail: this does not survive process death or "Don't keep activities";
            rememberSaveable would. Not worth eight of them and a Saver for one sheet's text.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:colorMode="default"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zheton" android:host="join" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="sync.zheton.app"
                    android:pathPrefix="/join" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuickAddActivity"
            android:exported="true"
            android:colorMode="default"
            android:theme="@style/Theme.MuchToman.Translucent">
            <intent-filter>
                <action android:name="com.pouyarn.zheton.action.QUICK_ADD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="zheton"
                    android:host="quick_add" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".TotalWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_total_info" />
        </receiver>

        <receiver
            android:name=".ChandTomanGlanceWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_glance_info" />
        </receiver>

        <receiver
            android:name=".MarketTickerWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_market_ticker_info" />
        </receiver>

        <receiver
            android:name=".SingleTickerMiniWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mini_ticker_info" />
        </receiver>

        <receiver
            android:name=".SafeSpendGlanceWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_safe_spend_info" />
        </receiver>

        <receiver
            android:name=".LiquidGoldGlanceWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_liquid_gold_info" />
        </receiver>

        <receiver
            android:name=".QuickAddGlanceWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add_info" />
        </receiver>

        <receiver
            android:name=".QuickCardsGlanceWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_cards_info" />
        </receiver>

        <service
            android:name=".QuickAddTileService"
            android:label="@string/tile_quick_add_label"
            android:icon="@drawable/ic_toman"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Offline tools added by the Poolaki-inspired map (#106). All four are opened from
            Settings and are deliberately not exported: nothing outside the app can start them,
            and they read the same on-device store the app does.
        -->
        <activity
            android:name=".features.smspicker.SmsPickerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|layoutDirection"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".features.reminders.ReminderSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".features.export.ReportExportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".features.backup.BackupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- «رسیدگی شد» on a reminder notification must work with the app not on screen. -->
        <receiver
            android:name=".features.reminders.ReminderActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.pouyarn.zheton.action.REMINDER_HANDLED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
