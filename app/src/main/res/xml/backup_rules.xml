<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup is disabled (android:allowBackup="false") to guarantee that all financial
    ledgers, bank SMS messages, and holdings remain 100% on-device. Users can export/import
    encrypted local backups explicitly from Settings.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
